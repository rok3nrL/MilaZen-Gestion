<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://milazen.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_Cliente" name="Cliente / Revendedor" processRef="Proc_Cliente" />
    <bpmn:participant id="Part_MilaZen" name="MilaZen – Proceso de venta con el software" processRef="Proc_MilaZen" />
    <bpmn:messageFlow id="Id_m01" name="Pedido" sourceRef="Id_c_t1" targetRef="Id_p_start" />
    <bpmn:messageFlow id="Id_m02" name="Productos y remito" sourceRef="Id_p_entrega" targetRef="Id_c_t2" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" isExecutable="false">
    <bpmn:startEvent id="Id_c_start" name="Necesita reponer stock">
      <bpmn:outgoing>Id_f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Id_c_t1" name="Enviar pedido">
      <bpmn:incoming>Id_f01</bpmn:incoming>
      <bpmn:outgoing>Id_f02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Id_c_t2" name="Recibir productos y remito">
      <bpmn:incoming>Id_f02</bpmn:incoming>
      <bpmn:outgoing>Id_f03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Id_c_end" name="Compra concluida">
      <bpmn:incoming>Id_f03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Id_f01" sourceRef="Id_c_start" targetRef="Id_c_t1" />
    <bpmn:sequenceFlow id="Id_f02" sourceRef="Id_c_t1" targetRef="Id_c_t2" />
    <bpmn:sequenceFlow id="Id_f03" sourceRef="Id_c_t2" targetRef="Id_c_end" />
  </bpmn:process>
  <bpmn:process id="Proc_MilaZen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sys" name="Sistema MilaZen (automático)">
        <bpmn:flowNodeRef>Id_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_precio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_pagada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_parcial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_s_alerta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Prop" name="Operador">
        <bpmn:flowNodeRef>Id_p_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_carga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_ajuste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_desc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_entrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Id_p_sel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Id_p_start" name="Pedido recibido">
      <bpmn:outgoing>Id_f04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_p_start" />
    </bpmn:startEvent>
    <bpmn:userTask id="Id_p_alta" name="Registrar cliente nuevo">
      <bpmn:incoming>Id_f06</bpmn:incoming>
      <bpmn:outgoing>Id_f07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Id_p_carga" name="Cargar productos y cantidades">
      <bpmn:incoming>Id_f07</bpmn:incoming>
      <bpmn:incoming>Id_f08</bpmn:incoming>
      <bpmn:incoming>Id_f12</bpmn:incoming>
      <bpmn:outgoing>Id_f09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Id_p_end" name="Venta finalizada">
      <bpmn:incoming>Id_f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Id_g1" name="¿Cliente registrado?">
      <bpmn:incoming>Id_f05</bpmn:incoming>
      <bpmn:outgoing>Id_f06</bpmn:outgoing>
      <bpmn:outgoing>Id_f08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Id_g2" name="¿Stock suficiente?">
      <bpmn:incoming>Id_f10</bpmn:incoming>
      <bpmn:outgoing>Id_f11</bpmn:outgoing>
      <bpmn:outgoing>Id_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Id_s_precio" name="Calcular total">
      <bpmn:incoming>Id_f13</bpmn:incoming>
      <bpmn:outgoing>Id_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Id_g3" name="¿Pago total?">
      <bpmn:incoming>Id_f15</bpmn:incoming>
      <bpmn:outgoing>Id_f16</bpmn:outgoing>
      <bpmn:outgoing>Id_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Id_s_pagada" name="Registrar venta como pagada">
      <bpmn:incoming>Id_f16</bpmn:incoming>
      <bpmn:outgoing>Id_f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Id_g4">
      <bpmn:incoming>Id_f18</bpmn:incoming>
      <bpmn:incoming>Id_f19</bpmn:incoming>
      <bpmn:outgoing>Id_f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Id_g5" name="¿Stock bajo el mínimo?">
      <bpmn:incoming>Id_f21</bpmn:incoming>
      <bpmn:outgoing>Id_f22</bpmn:outgoing>
      <bpmn:outgoing>Id_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Id_f04" sourceRef="Id_p_start" targetRef="Id_p_sel" />
    <bpmn:sequenceFlow id="Id_f05" sourceRef="Id_p_sel" targetRef="Id_g1" />
    <bpmn:sequenceFlow id="Id_f06" name="No" sourceRef="Id_g1" targetRef="Id_p_alta" />
    <bpmn:sequenceFlow id="Id_f07" sourceRef="Id_p_alta" targetRef="Id_p_carga" />
    <bpmn:sequenceFlow id="Id_f08" name="Sí" sourceRef="Id_g1" targetRef="Id_p_carga" />
    <bpmn:sequenceFlow id="Id_f12" sourceRef="Id_p_ajuste" targetRef="Id_p_carga" />
    <bpmn:sequenceFlow id="Id_f09" sourceRef="Id_p_carga" targetRef="Id_s_stock" />
    <bpmn:sequenceFlow id="Id_f11" name="No" sourceRef="Id_g2" targetRef="Id_p_ajuste" />
    <bpmn:sequenceFlow id="Id_f14" sourceRef="Id_s_precio" targetRef="Id_p_desc" />
    <bpmn:sequenceFlow id="Id_f15" sourceRef="Id_p_desc" targetRef="Id_g3" />
    <bpmn:sequenceFlow id="Id_f23" name="No" sourceRef="Id_g5" targetRef="Id_p_entrega" />
    <bpmn:sequenceFlow id="Id_f24" sourceRef="Id_s_alerta" targetRef="Id_p_entrega" />
    <bpmn:sequenceFlow id="Id_f25" sourceRef="Id_p_entrega" targetRef="Id_p_end" />
    <bpmn:sequenceFlow id="Id_f10" sourceRef="Id_s_stock" targetRef="Id_g2" />
    <bpmn:sequenceFlow id="Id_f13" name="Sí" sourceRef="Id_g2" targetRef="Id_s_precio" />
    <bpmn:sequenceFlow id="Id_f16" name="Sí" sourceRef="Id_g3" targetRef="Id_s_pagada" />
    <bpmn:sequenceFlow id="Id_f17" name="No" sourceRef="Id_g3" targetRef="Id_s_parcial" />
    <bpmn:sequenceFlow id="Id_f18" sourceRef="Id_s_pagada" targetRef="Id_g4" />
    <bpmn:sequenceFlow id="Id_f19" sourceRef="Id_s_parcial" targetRef="Id_g4" />
    <bpmn:sequenceFlow id="Id_f20" sourceRef="Id_g4" targetRef="Id_s_desc" />
    <bpmn:sequenceFlow id="Id_f21" sourceRef="Id_s_desc" targetRef="Id_g5" />
    <bpmn:sequenceFlow id="Id_f22" name="Sí" sourceRef="Id_g5" targetRef="Id_s_alerta" />
    <bpmn:serviceTask id="Id_s_stock" name="Verificar stock disponible">
      <bpmn:incoming>Id_f09</bpmn:incoming>
      <bpmn:outgoing>Id_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Id_p_ajuste" name="Ajustar  pedido o comunicarse con el cliente">
      <bpmn:incoming>Id_f11</bpmn:incoming>
      <bpmn:outgoing>Id_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Id_p_desc" name="Registrar medio de pago">
      <bpmn:incoming>Id_f14</bpmn:incoming>
      <bpmn:outgoing>Id_f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Id_s_parcial" name="Registrar     pago parcial y actualizar saldo">
      <bpmn:incoming>Id_f17</bpmn:incoming>
      <bpmn:outgoing>Id_f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Id_s_desc" name="Descontar stock y guardar detalle de venta">
      <bpmn:incoming>Id_f20</bpmn:incoming>
      <bpmn:outgoing>Id_f21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Id_p_entrega" name="Entregar productos y remito">
      <bpmn:incoming>Id_f23</bpmn:incoming>
      <bpmn:incoming>Id_f24</bpmn:incoming>
      <bpmn:outgoing>Id_f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Id_s_alerta" name="Generar alerta de producción">
      <bpmn:incoming>Id_f22</bpmn:incoming>
      <bpmn:outgoing>Id_f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Id_p_sel" name="Registrar pedido en el sistema">
      <bpmn:incoming>Id_f04</bpmn:incoming>
      <bpmn:outgoing>Id_f05</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
